# Script mode, run by tiny_embed at build time: writes IN's bytes to OUT as an array and its accessor.
# -DIN=<file> -DOUT=<cpp> -DNAME=<namespace part> -DSYMBOL=<accessor>

file(READ ${IN} _hex HEX)
string(LENGTH "${_hex}" _len)
math(EXPR _size "${_len} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
string(REPEAT "0x[0-9a-f][0-9a-f]," 24 _row) # CMake's regex has no {n}.
string(REGEX REPLACE "(${_row})" "\\1\n" _bytes "${_bytes}")
if(_size EQUAL 0)
    set(_bytes "0x00,") # An empty file still needs an array; the span below stays empty.
endif()

file(WRITE ${OUT}.tmp "// Generated by tiny_embed from ${IN}.

#include <cstddef>
#include <span>

namespace {

alignas(16) const unsigned char data[] = {
${_bytes}
};

} // namespace

namespace embedded::${NAME} {

auto ${SYMBOL}() -> std::span<const std::byte>
{
    return std::as_bytes(std::span{data}).first(${_size});
}

} // namespace embedded::${NAME}
")
file(RENAME ${OUT}.tmp ${OUT})
