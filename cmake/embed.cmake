# tiny_embed(<target> NAME <name> FILES <file>...)
#
# Compiles each file into <target> as bytes and generates <embedded/<name>.hpp>, which declares one accessor per
# file in namespace `embedded::<name>`: `auto <stem>() -> std::span<const std::byte>`, the stem being the file name
# made an identifier ("InterVariable.ttf" -> `intervariable_ttf`). One .cpp per file, so a change rebuilds one object.

set(_TINY_EMBED_SCRIPT ${CMAKE_CURRENT_LIST_DIR}/embed_file.cmake)

function(tiny_embed TARGET)
    cmake_parse_arguments(ARG "" "NAME" "FILES" ${ARGN})
    if(NOT ARG_NAME OR NOT ARG_FILES)
        message(FATAL_ERROR "tiny_embed: NAME and FILES are required.")
    endif()

    set(_dir ${CMAKE_CURRENT_BINARY_DIR}/tiny_embed)
    set(_decls "")
    foreach(_file IN LISTS ARG_FILES)
        get_filename_component(_abs ${_file} ABSOLUTE)
        get_filename_component(_base ${_abs} NAME)
        string(TOLOWER ${_base} _symbol)
        string(MAKE_C_IDENTIFIER ${_symbol} _symbol)
        set(_out ${_dir}/${ARG_NAME}/${_symbol}.cpp)
        add_custom_command(
            OUTPUT ${_out}
            COMMAND ${CMAKE_COMMAND} -DIN=${_abs} -DOUT=${_out} -DNAME=${ARG_NAME} -DSYMBOL=${_symbol} -P ${_TINY_EMBED_SCRIPT}
            DEPENDS ${_abs} ${_TINY_EMBED_SCRIPT}
            COMMENT "Embedding ${_base}"
            VERBATIM
        )
        target_sources(${TARGET} PRIVATE ${_out})
        string(APPEND _decls "auto ${_symbol}() -> std::span<const std::byte>; // ${_base}\n")
    endforeach()

    set(_header ${_dir}/include/embedded/${ARG_NAME}.hpp)
    file(CONFIGURE OUTPUT ${_header} CONTENT "#pragma once\n\n// Generated by tiny_embed.\n\n#include <cstddef>\n#include <span>\n\nnamespace embedded::${ARG_NAME} {\n\n${_decls}\n} // namespace embedded::${ARG_NAME}\n" @ONLY)
    target_include_directories(${TARGET} PRIVATE ${_dir}/include)
endfunction()
